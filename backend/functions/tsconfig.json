{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitReturns": true,
    "noImplicitAny": false,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2022",
    "resolveJsonModule": true,
    "typeRoots": ["src/types", "./node_modules/@types"],
    "esModuleInterop": true
  },
  "compileOnSave": true,
  "include": ["src"]
}
